+def _hwp5_plain(b: bytes, H) -> str:
+    """PARA_TEXT → 글만(확장·인라인 컨트롤 8칸은 건너뛴다)."""
+    u = struct.unpack_from(f"<{len(b) // 2}H", b, 0)
+    out, i = [], 0
+    while i < len(u):
+        c = u[i]
