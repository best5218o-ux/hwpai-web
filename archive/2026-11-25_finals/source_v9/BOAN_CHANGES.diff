+            res = await s.call_tool("search_chunks", {"path": mn, "query": "회의"})
+            rec("tools/call search_chunks", not g(res,'isError','is_error'))
+            out = os.path.join(HERE, "run", "변환 결과")
+            res = await s.call_tool("convert_to_hwpx", {"path": KO, "out": out})
