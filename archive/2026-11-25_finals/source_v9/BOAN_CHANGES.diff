+사용: python3 -I -B regress3.py <코드 폴더> <결과.jsonl> <조각> <조각 수>"""
+import json, os, sys, time, signal
+CODE, OUTP, K, N = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4])
