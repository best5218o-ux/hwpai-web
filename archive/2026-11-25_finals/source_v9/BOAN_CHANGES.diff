+            head, tail = x[:m0.end()], x[e0:]
+            spans = _top_paragraph_spans(x, m0.end(), e0)
+            cuts = [s for i, (s, e) in enumerate(spans) if i > 0 and "<hp:secPr" in x[s:e][:4000] and re.match(r'<hp:p\b[^>]*>\s*<hp:run\b[^>]*>\s*<hp:secPr\b', x[s:e])]
