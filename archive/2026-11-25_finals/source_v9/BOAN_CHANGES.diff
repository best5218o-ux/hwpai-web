+            self.assertEqual(r["not_inserted"], [])
+            d2 = audit(a, r["out"]).to_dict()
+            self.assertEqual(d2["verdict"], "PASS", json.dumps(d2["reasons"], ensure_ascii=False))
+            self.assertTrue(d2["checks"]["text_exact"])
+
