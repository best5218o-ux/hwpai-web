+$tbl = ($rows | Format-Table -AutoSize -Wrap | Out-String -Width 220)
+$top = "【npm 설치 진단 요약】`r`n" + (($diagTop | ForEach-Object { "  - $_" }) -join "`r`n") + "`r`n`r`n"
