+def load(path):
+    z = zipfile.ZipFile(path)
+    secs, nss = {}, {}
+    for n in z.namelist():
+        if n.startswith("Contents/section") and n.endswith(".xml"):
+            data = z.read(n)
+            for ev, (pfx, uri) in ET.iterparse(io.BytesIO(data), events=("start-ns",)):
+                nss.setdefault(pfx, uri)
+            secs[n] = ET.fromstring(data)
+    z.close()
+    return secs, nss
