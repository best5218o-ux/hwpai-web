diff --git a/src/serializer/hwpx/shape.rs b/src/serializer/hwpx/shape.rs
index df9946944..47142d200 100644
--- a/src/serializer/hwpx/shape.rs
+++ b/src/serializer/hwpx/shape.rs
@@ -46,6 +46,56 @@ use super::SerializeError;
 // <hp:rect>
 // =====================================================================
 
+/// [hwpai] 이미지로 채운 단순 사각형(글상자·캡션 없음)을 `<hp:pic>` 개체로 바꾼다.
+/// 한글은 `hp:rect` + `hc:imgBrush` 로 된 그림을 그리지 않으므로(HWP 원본의 그림은 대부분
+/// 이 형식이다), 한글이 직접 쓰는 그림 형식으로 낸다. 기준 크기는 그림 원래 픽셀 × 75 HWPUNIT.
+pub(super) fn image_rect_as_picture(
+    r: &RectangleShape,
+    ctx: &SerializeContext,
+) -> Option<crate::model::image::Picture> {
+    use crate::model::image::{CropInfo, ImageAttr, Picture};
+    if r.control_kind() != crate::model::shape::RectangleControlKind::Rectangle {
+        return None;
+    }
+    if r.drawing.fill.fill_type != FillType::Image {
+        return None;
+    }
+    // 글상자(글이 든 사각형)나 캡션이 있으면 글을 잃지 않도록 사각형 형식을 그대로 둔다
+    if r.drawing.text_box.is_some() || r.drawing.caption.is_some() {
+        return None;
+    }
+    let img = r.drawing.fill.image.as_ref()?;
+    let (pw, ph) = ctx.native_px(img.bin_data_id)?;
+    let nw = i32::try_from(pw.checked_mul(75)?).ok()?;
+    let nh = i32::try_from(ph.checked_mul(75)?).ok()?;
+    let (bright, contrast) = img.display_brightness_contrast();
+    let x = r.x_coords;
+    let y = r.y_coords;
+    let mut pic = Picture::default();
+    pic.common = r.common.clone();
+    pic.shape_attr = r.drawing.shape_attr.clone();
+    pic.border_attr = r.drawing.border_line;
+    pic.border_color = r.drawing.border_line.color;
+    pic.border_width = r.drawing.border_line.width;
+    pic.border_x = [x[0], y[0], x[1], y[1]];
+    pic.border_y = [x[2], y[2], x[3], y[3]];
+    pic.crop = CropInfo { left: 0, top: 0, right: nw, bottom: nh };
+    pic.img_dim = (nw as u32, nh as u32);
+    pic.image_attr = ImageAttr {
+        brightness: bright,
+        contrast,
+        bin_data_id: img.bin_data_id,
+        ..Default::default()
+    };
+    pic.instance_id = if r.drawing.inst_id != 0 {
+        r.drawing.inst_id
+    } else {
+        r.common.instance_id
+    };
+    pic.caption = r.drawing.caption.clone();
+    Some(pic)
+}
+
