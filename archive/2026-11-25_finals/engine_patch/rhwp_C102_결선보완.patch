+
+/// hwpai 로컬 보완(결선 4차 F1): [`Table::source_geometry`] 의 내용.
+#[derive(Debug, Clone, Default, PartialEq)]
+pub struct TableSourceGeometry {
+    pub width: HwpUnit,
+    pub height: HwpUnit,
+    /// 칸 순서대로 (row, col, row_span, col_span, width, height)
+    pub cells: Vec<(u16, u16, u16, u16, HwpUnit, HwpUnit)>,
+}
+
+impl Table {
+    /// hwpai 로컬 보완(결선 4차 F1): 지금 모델의 선언 기하를 원본 사본으로 찍는다.
+    pub(crate) fn capture_source_geometry(&mut self) {
+        let cells = self
+            .cells
+            .iter()
+            .map(|c| (c.row, c.col, c.row_span, c.col_span, c.width, c.height))
+            .collect();
+        self.source_geometry = Some(Box::new(TableSourceGeometry {
+            width: self.common.width,
+            height: self.common.height,
+            cells,
+        }));
+    }
+
+    /// hwpai 로컬 보완(결선 4차 F1): 칸 구성(위치·병합)이 사본과 같을 때만 선언 기하를 되돌린다.
+    /// 원본 값이 0 이거나 부호 있는 값으로 음수(손상·미기록)이면 그 값은 되돌리지 않는다 —
+    /// 한글도 그런 값은 고쳐 저장한다(보류 표본: 칸 높이 0→2448, 폭 3161653531→40780).
+    pub(crate) fn apply_source_geometry(&mut self) {
+        let Some(src) = self.source_geometry.as_deref() else {
+            return;
+        };
+        let sane = |v: HwpUnit| v > 0 && v <= i32::MAX as u32;
+        if src.cells.len() != self.cells.len()
+            || src
+                .cells
+                .iter()
+                .zip(&self.cells)
+                .any(|(s, c)| (s.0, s.1, s.2, s.3) != (c.row, c.col, c.row_span, c.col_span))
+        {
+            return;
+        }
+        let src = src.clone();
+        for (s, c) in src.cells.iter().zip(self.cells.iter_mut()) {
+            if sane(s.4) {
+                c.width = s.4;
+            }
+            if sane(s.5) {
+                c.height = s.5;
+            }
+        }
+        if sane(src.width) {
+            self.common.width = src.width;
+        }
+        if sane(src.height) {
+            self.common.height = src.height;
+        }
+    }
 }
 
